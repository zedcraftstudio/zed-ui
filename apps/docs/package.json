{
  "name": "@zed-ui/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "storybook build",
    "build:pages": "STORYBOOK_BASE_PATH=/storybook/ storybook build",
    "dev": "storybook dev -p 6006 --no-open",
    "lint": "eslint src .storybook",
    "typecheck": "tsc --noEmit",
    "test-storybook": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"node ../../scripts/serve-storybook.mjs\" \"wait-on tcp:6006 && test-storybook --url http://127.0.0.1:6006/storybook\""
  },
  "dependencies": {
    "@zed-ui/react": "workspace:*",
    "react": "^19.2.6",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@storybook/test-runner": "^0.24.4",
    "axe-playwright": "^2.0.3",
    "concurrently": "^9.1.2",
    "playwright": "^1.55.0",
    "storybook": "^10.4.6",
    "vite": "^8.0.14",
    "wait-on": "^8.0.3"
  }
}
