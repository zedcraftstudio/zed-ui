{
  "name": "@zed-ui/react",
  "version": "0.0.2",
  "description": "A fully typed React design system and component library.",
  "license": "MIT",
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "zed-ui",
    "headless",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zedcraftstudio/zed-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://zed-ui.zedcraftstudio.com/",
  "bugs": {
    "url": "https://github.com/zedcraftstudio/zed-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./box": {
      "types": "./dist/primitives/box/index.d.ts",
      "import": "./dist/primitives/box/index.js",
      "require": "./dist/primitives/box/index.cjs"
    },
    "./button": {
      "types": "./dist/actions/button/index.d.ts",
      "import": "./dist/actions/button/index.js",
      "require": "./dist/actions/button/index.cjs"
    },
    "./stack": {
      "types": "./dist/primitives/stack/index.d.ts",
      "import": "./dist/primitives/stack/index.js",
      "require": "./dist/primitives/stack/index.cjs"
    },
    "./text": {
      "types": "./dist/primitives/text/index.d.ts",
      "import": "./dist/primitives/text/index.js",
      "require": "./dist/primitives/text/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@zed-ui/hooks": "workspace:*",
    "@zed-ui/icons": "workspace:*",
    "@zed-ui/system": "workspace:*",
    "@zed-ui/themes": "workspace:*",
    "@zed-ui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0"
  },
  "devDependencies": {
    "@types/jest-axe": "^3.5.9",
    "jest-axe": "^10.0.0",
    "tsup": "^8.5.1"
  }
}
