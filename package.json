{
  "name": "zed-ui-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "turbo run dev --filter=@zed-ui/playground",
    "dev:docs": "turbo run dev --filter=@zed-ui/docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @zed-ui/react test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:storybook": "playwright test --config playwright.storybook.config.ts",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:ci": "pnpm build && NPM_CONFIG_PROVENANCE=true changeset publish",
    "publish:local": "pnpm build && pnpm -r --filter '@zed-ui/*' --filter '!@zed-ui/playground' --filter '!@zed-ui/docs' publish --access public --no-git-checks",
    "pack:dry-run": "pnpm build && pnpm pack:dry-run:only",
    "pack:dry-run:only": "pnpm -r --filter '@zed-ui/*' --filter '!@zed-ui/playground' --filter '!@zed-ui/docs' exec npm pack --dry-run",
    "size": "size-limit",
    "audit": "pnpm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.2",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.28.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "size-limit": "^11.1.6",
    "@size-limit/file": "^11.1.6",
    "turbo": "^2.5.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.9",
    "@vitest/coverage-v8": "4.1.9"
  }
}
